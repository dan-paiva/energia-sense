# Copie para .env e troque as senhas.

POSTGRES_SENHA=troque-esta-senha

# Usuário que a ingestão e o simulador usam no broker.
MQTT_USUARIO=energia
MQTT_SENHA=troque-esta-senha
# Usuário que os nós ESP32 usam (o mesmo configurado em firmware/include/config.h).
MQTT_USUARIO_NO=no-sensor
MQTT_SENHA_NO=troque-esta-senha

# Login do painel (HTTP Basic). Vazio = painel aberto, só para rede local de testes.
PAINEL_USUARIO=sindico
PAINEL_SENHA=

# Notificação dos alertas (opcional).
WEBHOOK_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
